{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/sem-conexao/index.html",
  "navigationUrls": ["!/**"],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/sem-conexao/index.html",
          "/manifest.webmanifest",
          "/favicon.png",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ]
}
