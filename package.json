{
  "name": "zetho",
  "version": "1.35.2",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "pnpm configure && ng serve",
    "build": "pnpm configure && ng build",
    "watch": "pnpm configure && ng build --watch --configuration development",
    "test": "pnpm configure && ng test",
    "bump": "node scripts/bump-version.js",
    "secrets:check": "bash scripts/check-secrets.sh",
    "configure": "node scripts/configure-environment.js",
    "test:ci": "pnpm configure && ng test --watch=false --browsers=ChromeHeadless",
    "test:tooling": "node --test scripts/configure-environment.test.js"
  },
  "imports": {
    "#app.css": "./src/styles.css"
  },
  "private": true,
  "dependencies": {
    "@angular/aria": "^21.0.5",
    "@angular/cdk": "^21.0.5",
    "@angular/common": "^20.3.27",
    "@angular/compiler": "^20.3.27",
    "@angular/core": "^20.3.27",
    "@angular/fire": "^20.0.1",
    "@angular/forms": "^20.3.27",
    "@angular/platform-browser": "^20.3.27",
    "@angular/platform-server": "^20.3.27",
    "@angular/router": "^20.3.27",
    "@angular/service-worker": "^20.3.27",
    "@angular/ssr": "^20.3.33",
    "@fontsource-variable/readex-pro": "^5.2.11",
    "@fontsource/jersey-10": "^5.2.8",
    "@phosphor-icons/web": "^2.1.2",
    "@tailwindcss/postcss": "^4.1.16",
    "@tiptap/core": "^3.26.1",
    "@tiptap/starter-kit": "^3.26.1",
    "appwrite": "^21.4.0",
    "express": "^5.2.1",
    "firebase": "^12.6.0",
    "html-to-image": "^1.11.13",
    "lexorank": "^1.0.5",
    "ngx-tiptap": "^14.0.1",
    "postcss": "^8.5.6",
    "rxjs": "~7.8.0",
    "slugify": "^1.6.6",
    "tailwindcss": "^4.1.16",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.33",
    "@angular/cli": "^20.3.33",
    "@angular/compiler-cli": "^20.3.27",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^26.2.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.7.3",
    "typescript": "~5.9.2"
  },
  "description": "Zetho: registre sua vida nos jogos e compartilhe com sua comunidade.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bielframos/Zetho.git"
  },
  "bugs": {
    "url": "https://github.com/Bielframos/Zetho/issues"
