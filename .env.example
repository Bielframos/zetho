# All PUBLIC_* values are visible to visitors. Never put server secrets here.
PUBLIC_APP_URL=http://localhost:4200/
PUBLIC_API_URL=http://localhost:3000/
PUBLIC_APPWRITE_ENDPOINT=http://localhost/v1
PUBLIC_APPWRITE_PROJECT=zetho-local
PUBLIC_THEMES_BUCKET_ID=zetho-themes

# Optional Firebase Analytics. Disabled when API key / project / app ID are absent.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=
